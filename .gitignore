*.mp4
*.mov
*.MOV
*.MP4
*.mkv
*.m4v
*.wav
*.mp3
*.m4a
*.aac
*.srt.bak

# HyperFrames y Node
node_modules/
videos/*/hyperframes/**/renders/
videos/*/hyperframes/**/output/
